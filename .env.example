# Copy this file to .env and fill in real values. .env is gitignored.

# SQL Server 'sa' password. Must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit or symbol).
SA_PASSWORD=Your_password123

# JWT signing configuration (config binding only for now; auth scheme wired up in a later epic)
JWT_SIGNING_KEY=change-me-to-a-long-random-string
JWT_ISSUER=EkoaGym
JWT_AUDIENCE=EkoaGym

ASPNETCORE_ENVIRONMENT=Development
