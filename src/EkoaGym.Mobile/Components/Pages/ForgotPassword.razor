@page "/forgot-password"
@layout AuthLayout
@inject ApiClient Api
@inject NavigationManager Navigation

<h1 class="mb-6 text-center text-xl font-semibold">Forgot password</h1>

@if (submitted)
{
    <p class="text-center text-sm text-text-secondary">
        If that email exists, we've sent a link to reset your password.
    </p>
    <a href="/login" class="mt-6 block text-center text-sm text-text-secondary underline">Back to login</a>
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleSubmitAsync" class="flex flex-col gap-4">
        <DataAnnotationsValidator />

        <div>
            <label class="label" for="email">Email</label>
            <InputText id="email" class="input" @bind-Value="model.Email" />
            <ValidationMessage For="() => model.Email" class="form-error" />
        </div>

        <ErrorBanner Message="@errorMessage" />

        @if (isSubmitting)
        {
            <LoadingIndicator Message="Sending..." />
        }
        else
        {
            <button type="submit" class="btn-primary">Send reset link</button>
        }

        <a href="/login" class="text-center text-sm text-text-secondary underline">Back to login</a>
    </EditForm>
}

@code {
    private readonly ForgotPasswordModel model = new();
    private string? errorMessage;
    private bool isSubmitting;
    private bool submitted;

    private async Task HandleSubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;
        try
        {
            await Api.PostAsync("api/auth/forgot-password", new ForgotPasswordRequest(model.Email));
            submitted = true;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
