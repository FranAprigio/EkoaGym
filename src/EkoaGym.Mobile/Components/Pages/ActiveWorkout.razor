@page "/active-workout/{PlanId:guid}"
@using EkoaGym.Mobile.Services.Data.Entities
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Text.Json
@inject ApiClient Api
@inject ISyncService SyncService
@inject LocalDatabaseService Db
@inject IRestTimerNotifier RestNotifier
@inject IMotionService Motion
@inject NavigationManager Navigation
@implements IDisposable

@if (isLoading)
{
    <LoadingIndicator />
}
else if (isCompleted)
{
    <div class="card flex flex-col items-center gap-3 text-center animate-fade-in-up">
        <span class="text-3xl">✅</span>
        <p class="text-lg font-semibold">Workout complete!</p>
        @if (completionResult is not null)
        {
            <p class="text-sm text-text-secondary">Duration: @FormatDuration(completionResult.StartedAt, completionResult.EndedAt)</p>
        }
        <div class="flex gap-6">
            <div>
                <p class="text-2xl font-semibold text-primary"><CountUp Value="finishedSetsLogged" /></p>
                <p class="text-xs text-text-secondary">Sets logged</p>
            </div>
            @if (finishedPrCount > 0)
            {
                <div>
                    <p class="text-2xl font-semibold text-accent"><CountUp Value="finishedPrCount" /></p>
                    <p class="text-xs text-text-secondary">Personal record(s) 🏆</p>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(pendingSyncMessage))
        {
            <p class="text-xs text-text-secondary">@pendingSyncMessage</p>
        }
        @if (sessionScore is not null)
        {
            <div class="card w-full text-left">
                <div class="mb-2 flex items-center justify-between">
                    <p class="font-medium">League score</p>
                    <p class="text-xl font-semibold text-primary"><CountUp Value="@((double)sessionScore.TotalScore)" Format="0.0" /></p>
                </div>
                @foreach (var line in sessionScore.ExerciseBreakdown)
                {
                    <p class="text-sm text-text-secondary">
                        @line.ExerciseName: @line.Score.ToString("0.0")
                        @(line.HasPendingSets ? " (some sets pending review)" : "")
                    </p>
                }
                @if (sessionScore.ConsistencyBonus > 0)
                {
                    <p class="text-sm text-accent">+@sessionScore.ConsistencyBonus.ToString("0") Consistency bonus</p>
                }
                @if (sessionScore.PrBonus > 0)
                {
                    <p class="text-sm text-accent">+@sessionScore.PrBonus.ToString("0") PR bonus 🏆</p>
                }
            </div>
        }
        <button type="button" class="btn-primary w-full" @onclick='() => Navigation.NavigateTo("/my-workout")'>Back to My Workout</button>
    </div>
}
else if (state is null)
{
    <ErrorBanner Message="@errorMessage" />
    @if (otherActivePlanId is Guid otherId)
    {
        <button type="button" class="btn-outline mt-3 w-full" @onclick="() => ResumeOtherWorkout(otherId)">Resume that workout instead</button>
    }
}
else
{
    <h1 class="mb-1 text-xl font-semibold">@state.PlanName</h1>
    <p class="mb-4 text-sm text-text-secondary">Exercise @(state.CurrentExerciseIndex + 1) of @state.Exercises.Count</p>

    @if (CurrentExercise is not null)
    {
        <div class="card mb-4 flex flex-col gap-3">
            <p class="text-lg font-medium">@CurrentExercise.ExerciseName</p>
            <p class="text-sm text-info">Target: @CurrentExercise.Sets sets × @CurrentExercise.Reps reps at @CurrentExercise.WeightKg kg</p>

            @if (restSecondsRemaining > 0)
            {
                <div class="rounded-lg border border-info bg-info/10 px-4 py-3 text-center">
                    <p class="text-sm text-info">Resting...</p>
                    <p class="text-2xl font-semibold text-info">@restSecondsRemaining s</p>
                </div>
            }

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="label">Actual reps</label>
                    <InputNumber class="input" @bind-Value="actualReps" />
                </div>
                <div>
                    <label class="label">Actual weight (kg)</label>
                    <InputNumber class="input" @bind-Value="actualWeightKg" />
                </div>
            </div>

            <button type="button" class="btn-primary relative" @onclick="LogSetAsync">
                Log Set
                @* M-9.1/M-9.3: @key forces a fresh element each successful log so the one-shot CSS
                   pulse animation always replays, distinct from the end-of-workout celebration. *@
                @if (logPulseCount > 0)
                {
                    <span @key="logPulseCount" class="pointer-events-none absolute inset-0 rounded-lg ring-4 ring-accent animate-success-pulse"></span>
                }
            </button>

            @if (CurrentExercise.LoggedSets.Count > 0)
            {
                <div class="flex flex-col gap-2">
                    @foreach (var set in CurrentExercise.LoggedSets)
                    {
                        <div>
                            <p class="text-sm @(set.IsWeightPR || set.IsRepPR ? "font-semibold text-accent animate-pr-pop" : "text-text-secondary")">
                                Set @set.SetNumber: @set.ActualReps reps at @set.ActualWeightKg kg
                                @(set.Synced ? "" : "(pending sync)")
                                @(set.IsWeightPR ? " 🏆 Weight PR" : "")
                                @(set.IsRepPR ? " 🏆 Rep PR" : "")
                            </p>
                            @if (set.IsSuspicious && set.VerificationStatus == "PendingReview")
                            {
                                @if (set.ProofSubmitted)
                                {
                                    <span class="rounded-full bg-pending/20 px-2 py-0.5 text-xs font-medium text-pending">Pending review — proof submitted</span>
                                }
                                else
                                {
                                    <button type="button" class="rounded-full bg-pending/20 px-2 py-0.5 text-xs font-medium text-pending underline" @onclick="() => SubmitProofAsync(set)">
                                        Unusually large jump — submit proof to unlock points
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="mb-4 flex gap-3">
            <button type="button" class="btn-outline flex-1" disabled="@(state.CurrentExerciseIndex == 0)" @onclick="PreviousExercise">Previous</button>
            <button type="button" class="btn-outline flex-1" disabled="@(state.CurrentExerciseIndex == state.Exercises.Count - 1)" @onclick="NextExercise">Next</button>
        </div>
    }

    <ErrorBanner Message="@errorMessage" />

    @if (isSaving)
    {
        <LoadingIndicator Message="Finishing..." />
    }
    else
    {
        <div class="flex gap-3">
            <button type="button" class="btn-outline flex-1" @onclick='() => Navigation.NavigateTo("/my-workout")'>Pause</button>
            <button type="button" class="btn-primary flex-1" @onclick="FinishAsync">Finish Workout</button>
        </div>
    }
}

@if (showWeightLimitWarning)
{
    <ModalOverlay OnClose="() => showWeightLimitWarning = false">
        <p class="mb-3 font-medium">That weight looks too high</p>
        <p class="mb-4 text-sm text-text-secondary">@weightLimitMessage</p>
        <button type="button" class="btn-primary w-full" @onclick="() => showWeightLimitWarning = false">Got it</button>
    </ModalOverlay>
}

@code {
    [Parameter] public Guid PlanId { get; set; }

    private Guid? loadedForPlanId;
    private ActiveWorkoutState? state;
    private bool isLoading = true;
    private bool isSaving;
    private bool isCompleted;
    private string? errorMessage;
    private string? pendingSyncMessage;
    private Guid? otherActivePlanId;
    private CompleteSessionResult? completionResult;

    private int actualReps;
    private decimal actualWeightKg;
    private int restSecondsRemaining;
    private CancellationTokenSource? restCts;
    private int logPulseCount;
    private int finishedSetsLogged;
    private int finishedPrCount;
    private Dictionary<Guid, decimal> exerciseLimits = [];
    private bool showWeightLimitWarning;
    private string weightLimitMessage = string.Empty;
    private SessionScore? sessionScore;

    private ActiveWorkoutExercise? CurrentExercise => state?.Exercises.ElementAtOrDefault(state.CurrentExerciseIndex);

    protected override async Task OnParametersSetAsync()
    {
        if (loadedForPlanId == PlanId)
        {
            return;
        }

        loadedForPlanId = PlanId;
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        isLoading = true;
        errorMessage = null;
        otherActivePlanId = null;
        restCts?.Cancel();

        var limits = await SyncService.GetExerciseLimitsAsync();
        exerciseLimits = limits.ToDictionary(l => l.ExerciseId, l => l.MaxWeightKg);

        try
        {
            var existingRow = await Db.GetActiveSessionAsync();
            var existingState = existingRow is null ? null : JsonSerializer.Deserialize<ActiveWorkoutState>(existingRow.PayloadJson);

            if (existingState is not null && existingState.PlanId == PlanId)
            {
                state = existingState;
            }
            else if (existingState is not null)
            {
                errorMessage = $"You have another workout in progress (\"{existingState.PlanName}\"). Finish or discard it before starting a new one.";
                otherActivePlanId = existingState.PlanId;
                state = null;
                return;
            }
            else
            {
                state = await StartNewSessionAsync();
            }

            if (state is not null)
            {
                PrefillInputsForCurrentExercise();
                ResumeRestTimerIfNeeded();
            }
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<ActiveWorkoutState?> StartNewSessionAsync()
    {
        // Starting a workout requires connectivity — there's no server-side session yet to log sets against.
        var response = await Api.PostAsync<StartSessionResult>("api/sessions", new { PlanId });
        if (response is null)
        {
            return null;
        }

        var plans = await SyncService.GetPlansAsync();
        var planName = plans.FirstOrDefault(p => p.Id == response.PlanId)?.Name ?? "Workout";

        var newState = new ActiveWorkoutState
        {
            SessionId = response.SessionId,
            PlanId = response.PlanId,
            PlanName = planName,
            StartedAt = response.StartedAt,
            Exercises = response.Exercises.Select(e => new ActiveWorkoutExercise
            {
                ExerciseId = e.ExerciseId,
                ExerciseName = e.ExerciseName,
                Sets = e.Sets,
                Reps = e.Reps,
                WeightKg = e.WeightKg,
                RestSeconds = e.RestSeconds,
            }).ToList(),
        };

        await SaveStateAsync(newState);
        return newState;
    }

    private void PrefillInputsForCurrentExercise()
    {
        if (CurrentExercise is null)
        {
            return;
        }

        actualReps = CurrentExercise.Reps;
        actualWeightKg = CurrentExercise.WeightKg;
    }

    private async Task LogSetAsync()
    {
        if (state is null || CurrentExercise is null)
        {
            return;
        }

        var exercise = CurrentExercise;

        // M-10.3: client-side check is a UX convenience only — BE-5.2 enforces the real cap server-side.
        if (exerciseLimits.TryGetValue(exercise.ExerciseId, out var maxWeightKg) && actualWeightKg > maxWeightKg)
        {
            weightLimitMessage = $"{exercise.ExerciseName} has a maximum allowed weight of {maxWeightKg} kg. Please double-check your entry.";
            showWeightLimitWarning = true;
            return;
        }

        await EnsureProgressBaselineAsync(exercise);

        var setNumber = exercise.LoggedSets.Count + 1;
        var loggedSet = new LoggedSet
        {
            SetNumber = setNumber,
            ActualReps = actualReps,
            ActualWeightKg = actualWeightKg,
            CompletedAt = DateTime.UtcNow,
            Synced = false,
            IsWeightPR = actualWeightKg > (exercise.BestWeightKgBeforeSession ?? 0),
            IsRepPR = actualWeightKg >= (exercise.BestWeightKgBeforeSession ?? 0) && actualReps > (exercise.BestRepsAtBestWeightBeforeSession ?? 0),
        };

        // Update the running baseline so a LATER, further-improving set in this same session can still
        // show its own incremental PR badge, without re-firing for a merely-equal repeat of this one.
        if (loggedSet.IsWeightPR)
        {
            exercise.BestWeightKgBeforeSession = actualWeightKg;
        }
        if (loggedSet.IsRepPR || loggedSet.IsWeightPR)
        {
            exercise.BestRepsAtBestWeightBeforeSession = Math.Max(exercise.BestRepsAtBestWeightBeforeSession ?? 0, actualReps);
        }

        // Optimistic local update first — the UI must reflect the logged set regardless of connectivity.
        exercise.LoggedSets.Add(loggedSet);
        logPulseCount++;

        var request = new LogSetRequest(exercise.ExerciseId, setNumber, actualReps, actualWeightKg);
        try
        {
            var result = await Api.PostAsync<LogSetResult>($"api/sessions/{state.SessionId}/sets", request);
            if (result is not null)
            {
                loggedSet.Id = result.Id;
                loggedSet.IsSuspicious = result.IsSuspicious;
                loggedSet.VerificationStatus = result.VerificationStatus;
            }

            loggedSet.Synced = true;
        }
        catch (ApiException ex) when (ex.ErrorCode is "network_error" or "timeout")
        {
            await SyncService.QueueWriteAsync(HttpMethod.Post, $"api/sessions/{state.SessionId}/sets", request);
        }
        catch (ApiException ex)
        {
            // A real server-side rejection (e.g. a stale cached cap) — not an offline situation, so the
            // optimistic entry is rolled back instead of being left to sync later.
            exercise.LoggedSets.Remove(loggedSet);
            errorMessage = ex.Message;
        }

        await SaveStateAsync(state);
        StartRestTimer(exercise.RestSeconds);
    }

    // M-10.4: reuses the same MediaPicker capture/pick pattern as progress photos (M-7.2).
    private async Task SubmitProofAsync(LoggedSet set)
    {
        if (set.Id is null)
        {
            return;
        }

        try
        {
            var photos = await Microsoft.Maui.Media.MediaPicker.Default.PickPhotosAsync();
            var file = photos.FirstOrDefault();
            if (file is null)
            {
                return;
            }

            await using var stream = await file.OpenReadAsync();
            using var content = new MultipartFormDataContent();
            using var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType);
            content.Add(streamContent, "File", file.FileName);
            content.Add(new StringContent(set.Id.Value.ToString()), "SessionSetLogId");

            await Api.PostMultipartAsync<VerificationResult>("api/verification/submit", content);
            set.ProofSubmitted = true;
            if (state is not null)
            {
                await SaveStateAsync(state);
            }
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch
        {
            errorMessage = "Couldn't access your photos.";
        }
    }

    // Lazily fetches the exercise's history-so-far (M-7.3's existing endpoint, no new backend needed) once
    // per exercise per session, so mid-session PR badges compare against real all-time bests, not just
    // sets logged earlier in this same workout.
    private async Task EnsureProgressBaselineAsync(ActiveWorkoutExercise exercise)
    {
        if (exercise.ProgressBaselineLoaded)
        {
            return;
        }

        exercise.ProgressBaselineLoaded = true;
        try
        {
            var points = await Api.GetAsync<List<ExerciseProgressPoint>>($"api/exercises/{exercise.ExerciseId}/progress");
            if (points is { Count: > 0 })
            {
                var bestWeight = points.Max(p => p.BestSetWeightKg);
                var bestReps = points.Where(p => p.BestSetWeightKg >= bestWeight).Max(p => p.BestSetReps);
                exercise.BestWeightKgBeforeSession = bestWeight;
                exercise.BestRepsAtBestWeightBeforeSession = bestReps;
            }
        }
        catch (ApiException)
        {
            // Offline or unavailable — no baseline means no PR badges for this exercise this session,
            // which is a safe, non-blocking degradation (never invents a false PR).
        }
    }

    private void StartRestTimer(int restSeconds)
    {
        if (state is null || restSeconds <= 0)
        {
            return;
        }

        state.RestEndsAtUtc = DateTime.UtcNow.AddSeconds(restSeconds);
        _ = SaveStateAsync(state);
        BeginRestCountdown();
    }

    private void ResumeRestTimerIfNeeded()
    {
        if (state?.RestEndsAtUtc is DateTime endsAt && endsAt > DateTime.UtcNow)
        {
            BeginRestCountdown();
        }
    }

    private void BeginRestCountdown()
    {
        restCts?.Cancel();
        var cts = new CancellationTokenSource();
        restCts = cts;
        _ = RunRestCountdownAsync(cts.Token);
    }

    private async Task RunRestCountdownAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested && state?.RestEndsAtUtc is DateTime endsAt)
            {
                var remaining = endsAt - DateTime.UtcNow;
                if (remaining <= TimeSpan.Zero)
                {
                    break;
                }

                restSecondsRemaining = (int)Math.Ceiling(remaining.TotalSeconds);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(TimeSpan.FromSeconds(1), ct);
            }

            if (!ct.IsCancellationRequested && state is not null)
            {
                restSecondsRemaining = 0;
                await RestNotifier.NotifyRestOverAsync(CurrentExercise?.ExerciseName ?? "your next set");
                state.RestEndsAtUtc = null;
                await SaveStateAsync(state);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer rest period or the page was navigated away from.
        }
    }

    private void PreviousExercise()
    {
        if (state is null || state.CurrentExerciseIndex <= 0)
        {
            return;
        }

        state.CurrentExerciseIndex--;
        PrefillInputsForCurrentExercise();
        _ = SaveStateAsync(state);
    }

    private void NextExercise()
    {
        if (state is null || state.CurrentExerciseIndex >= state.Exercises.Count - 1)
        {
            return;
        }

        state.CurrentExerciseIndex++;
        PrefillInputsForCurrentExercise();
        _ = SaveStateAsync(state);
    }

    private async Task FinishAsync()
    {
        if (state is null)
        {
            return;
        }

        isSaving = true;
        errorMessage = null;
        try
        {
            try
            {
                completionResult = await Api.PutAsync<CompleteSessionResult>($"api/sessions/{state.SessionId}/complete");
                pendingSyncMessage = null;
            }
            catch (ApiException)
            {
                await SyncService.QueueWriteAsync(HttpMethod.Put, $"api/sessions/{state.SessionId}/complete", null);
                completionResult = new CompleteSessionResult(state.SessionId, state.StartedAt, DateTime.UtcNow);
                pendingSyncMessage = "You're offline — this will finish syncing once you're back online.";
            }

            finishedSetsLogged = state.Exercises.Sum(e => e.LoggedSets.Count);
            finishedPrCount = state.Exercises.SelectMany(e => e.LoggedSets).Count(s => s.IsWeightPR || s.IsRepPR);

            restCts?.Cancel();
            await Db.ClearActiveSessionAsync();
            isCompleted = true;

            // M-9.3: the end-of-workout celebration, distinct from the smaller per-set pulse above —
            // MotionService itself skips this for prefers-reduced-motion, leaving just the summary card.
            await Motion.BurstConfettiAsync("#E8734A", "#F2A65A", "#7FB069");

            // M-10.2: only meaningful once the session is actually completed server-side — silently
            // skipped if we're offline (pendingSyncMessage above already explains that to the user).
            if (pendingSyncMessage is null)
            {
                try
                {
                    sessionScore = await Api.GetAsync<SessionScore>($"api/sessions/{state.SessionId}/score");
                }
                catch (ApiException)
                {
                    sessionScore = null;
                }
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task SaveStateAsync(ActiveWorkoutState toSave) =>
        Db.SaveActiveSessionAsync(new CachedActiveSession { PayloadJson = JsonSerializer.Serialize(toSave) });

    private void ResumeOtherWorkout(Guid otherPlanId) => Navigation.NavigateTo($"/active-workout/{otherPlanId}");

    private static string FormatDuration(DateTime startedAt, DateTime endedAt)
    {
        var duration = endedAt - startedAt;
        return duration.TotalHours >= 1 ? $"{duration:h\\hmm\\m}" : $"{duration:mm\\mss\\s}";
    }

    public void Dispose()
    {
        restCts?.Cancel();
    }
}
