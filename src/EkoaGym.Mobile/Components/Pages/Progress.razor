@page "/progress"
@inject ISyncService SyncService
@inject NavigationManager Navigation

<h1 class="mb-4 text-xl font-semibold">Progress</h1>

@if (isLoading)
{
    <LoadingIndicator />
}
else if (lastSession is null)
{
    <EmptyState Icon="📈" Title="No progress yet" Description="Complete a workout session to start tracking progress." />
}
else
{
    <div class="card mb-4">
        <p class="font-medium">Last completed session</p>
        <p class="text-sm text-text-secondary">@lastSession.PlanName</p>
        <p class="text-sm">Total volume: @lastSession.TotalVolumeKg kg</p>
        <p class="text-sm">Exercises: @lastSession.ExerciseCount</p>
    </div>
}

<button type="button" class="btn-outline w-full" @onclick='() => Navigation.NavigateTo("/workout-history")'>View full workout history</button>


@code {
    private bool isLoading = true;
    private SessionSummary? lastSession;

    protected override async Task OnInitializedAsync()
    {
        lastSession = await SyncService.GetLastSessionAsync();
        isLoading = false;
    }
}
