@page "/my-workout"
@using EkoaGym.Mobile.Services.Data.Entities
@using System.Text.Json
@inject ISyncService SyncService
@inject ApiClient Api
@inject LocalDatabaseService Db
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="mb-4 flex items-center justify-between">
    <h1 class="text-xl font-semibold">My Workout</h1>
    <button type="button" class="btn-primary" @onclick='() => Navigation.NavigateTo("/plans/new")'>+ New Plan</button>
</div>

@if (activeSessionPlanId is Guid activeId)
{
    <button type="button" class="card mb-4 flex w-full items-center justify-between border-info" @onclick="() => ResumeWorkout(activeId)">
        <span>Resume "@activeSessionPlanName" workout</span>
        <span class="text-info">Resume</span>
    </button>
}

@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    <ErrorBanner Message="@errorMessage" OnRetry="LoadAsync" />

    @if (plans.Count == 0 && errorMessage is null)
    {
        <EmptyState Icon="🏋️" Title="No workout plans yet" Description="Create a plan to get started." />
    }
    else
    {
        <div class="flex flex-col gap-3">
            @foreach (var plan in plans)
            {
                <PlanCard Plan="plan" OnStart="ResumeWorkout" OnEdit="EditPlanAsync" OnDuplicate="DuplicatePlanAsync" OnDelete="DeletePlanAsync" />
            }
        </div>
    }
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<PlanSummary> plans = [];
    private Guid? activeSessionPlanId;
    private string? activeSessionPlanName;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            plans = (await SyncService.GetPlansAsync()).ToList();

            var activeRow = await Db.GetActiveSessionAsync();
            var activeState = activeRow is null ? null : JsonSerializer.Deserialize<ActiveWorkoutState>(activeRow.PayloadJson);
            activeSessionPlanId = activeState?.PlanId;
            activeSessionPlanName = activeState?.PlanName;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResumeWorkout(Guid planId) => Navigation.NavigateTo($"/active-workout/{planId}");

    private Task EditPlanAsync(Guid id)
    {
        Navigation.NavigateTo($"/plans/{id}/edit");
        return Task.CompletedTask;
    }

    private async Task DuplicatePlanAsync(Guid id)
    {
        errorMessage = null;
        try
        {
            await Api.PostAsync($"api/plans/{id}/duplicate");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeletePlanAsync(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this plan? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        errorMessage = null;
        try
        {
            await Api.DeleteAsync($"api/plans/{id}");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
    }
}
