@page "/exercises"
@inject ISyncService SyncService
@inject NavigationManager Navigation
@implements IDisposable

<h1 class="mb-4 text-xl font-semibold">Exercise Library</h1>

<div class="mb-4 flex flex-col gap-2">
    <input class="input" placeholder="Search exercises..." value="@searchText" @oninput="OnSearchChanged" />

    <div class="flex gap-2">
        <select class="input" value="@muscleGroup" @onchange="OnMuscleGroupChanged">
            <option value="">All muscle groups</option>
            @foreach (var value in MuscleGroups)
            {
                <option value="@value">@value</option>
            }
        </select>

        <select class="input" value="@equipment" @onchange="OnEquipmentChanged">
            <option value="">All equipment</option>
            @foreach (var value in EquipmentOptions)
            {
                <option value="@value">@value</option>
            }
        </select>

        <select class="input" value="@difficulty" @onchange="OnDifficultyChanged">
            <option value="">All levels</option>
            @foreach (var value in DifficultyOptions)
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>
</div>

@if (isLoading)
{
    <LoadingIndicator />
}
else
{
    <ErrorBanner Message="@errorMessage" OnRetry="() => LoadAsync(resetPage: true)" />

    @if (exercises.Count == 0 && errorMessage is null)
    {
        <EmptyState Icon="📋" Title="No exercises found" Description="Try a different search or filter." />
    }
    else
    {
        <div class="flex flex-col gap-2">
            @foreach (var exercise in exercises)
            {
                <div class="card flex cursor-pointer items-center justify-between" @onclick="() => GoToDetail(exercise.Id)">
                    <div>
                        <p class="font-medium">@exercise.Name</p>
                        <p class="text-sm text-text-secondary">@exercise.MuscleGroup · @exercise.Equipment</p>
                    </div>
                    <span class="text-xs text-text-secondary">@exercise.Difficulty</span>
                </div>
            }
        </div>

        @if (hasMore)
        {
            @if (isLoadingMore)
            {
                <LoadingIndicator Message="Loading more..." />
            }
            else
            {
                <button type="button" class="btn-outline mt-3 w-full" @onclick="LoadMoreAsync">Load more</button>
            }
        }
    }
}

@code {
    private static readonly string[] MuscleGroups =
        ["Chest", "Back", "Shoulders", "Biceps", "Triceps", "Forearms", "Abs", "Quadriceps", "Hamstrings", "Glutes", "Calves", "FullBody", "Cardio"];

    private static readonly string[] EquipmentOptions =
        ["Bodyweight", "Barbell", "Dumbbell", "Kettlebell", "Machine", "Cable", "ResistanceBand", "PullUpBar", "Bench", "MedicineBall", "Other"];

    private static readonly string[] DifficultyOptions = ["Beginner", "Intermediate", "Advanced"];

    private const int PageSize = 20;

    private readonly List<ExerciseSummary> exercises = [];
    private string searchText = string.Empty;
    private string muscleGroup = string.Empty;
    private string equipment = string.Empty;
    private string difficulty = string.Empty;
    private int page = 1;
    private int totalCount;
    private bool isLoading = true;
    private bool isLoadingMore;
    private string? errorMessage;
    private CancellationTokenSource? searchDebounce;

    private bool hasMore => exercises.Count < totalCount;

    protected override Task OnInitializedAsync() => LoadAsync(resetPage: true);

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;

        searchDebounce?.Cancel();
        var cts = new CancellationTokenSource();
        searchDebounce = cts;

        _ = DebounceSearchAsync(cts);
    }

    private async Task DebounceSearchAsync(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(300, cts.Token);
            await InvokeAsync(() => LoadAsync(resetPage: true));
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke — ignore.
        }
    }

    private Task OnMuscleGroupChanged(ChangeEventArgs e)
    {
        muscleGroup = e.Value?.ToString() ?? string.Empty;
        return LoadAsync(resetPage: true);
    }

    private Task OnEquipmentChanged(ChangeEventArgs e)
    {
        equipment = e.Value?.ToString() ?? string.Empty;
        return LoadAsync(resetPage: true);
    }

    private Task OnDifficultyChanged(ChangeEventArgs e)
    {
        difficulty = e.Value?.ToString() ?? string.Empty;
        return LoadAsync(resetPage: true);
    }

    private async Task LoadAsync(bool resetPage)
    {
        if (resetPage)
        {
            page = 1;
            exercises.Clear();
        }

        isLoading = exercises.Count == 0;
        isLoadingMore = !isLoading;
        errorMessage = null;
        try
        {
            var filter = new ExerciseSearchFilter(
                string.IsNullOrEmpty(muscleGroup) ? null : muscleGroup,
                string.IsNullOrEmpty(equipment) ? null : equipment,
                string.IsNullOrEmpty(difficulty) ? null : difficulty,
                string.IsNullOrWhiteSpace(searchText) ? null : searchText,
                page,
                PageSize);

            var result = await SyncService.SearchExercisesAsync(filter);
            if (resetPage)
            {
                exercises.Clear();
            }

            exercises.AddRange(result.Items);
            totalCount = result.TotalCount;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            isLoadingMore = false;
        }
    }

    private Task LoadMoreAsync()
    {
        page++;
        return LoadAsync(resetPage: false);
    }

    private void GoToDetail(Guid id) => Navigation.NavigateTo($"/exercises/{id}");

    public void Dispose()
    {
        searchDebounce?.Cancel();
    }
}
