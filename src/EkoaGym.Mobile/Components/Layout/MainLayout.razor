@inherits LayoutComponentBase
@inject ISyncService SyncService
@inject ITokenStore TokenStore
@inject AuthState AuthState
@inject IBiometricLoginService BiometricLoginService
@inject ProfileLanguageSync LanguageSync
@inject NavigationManager Navigation
@implements IDisposable

<div class="flex min-h-screen flex-col bg-background text-text-primary">
    <OfflineBanner />

    <main class="flex-1 overflow-y-auto px-4 pb-20 pt-4">
        @if (isAuthorized)
        {
            @* M-9.2: @key forces a fresh DOM node per navigation so the CSS animation class always
               replays; NavMenu/OfflineBanner sit outside this wrapper and stay static across navigation. *@
            <div @key="transitionKey" class="@transitionClass">
                @Body
            </div>
        }
        else
        {
            <LoadingIndicator Message="Checking your session..." />
        }
    </main>

    @if (isAuthorized)
    {
        <NavMenu />
    }
</div>

@code {
    private bool isAuthorized;
    private readonly List<string> navHistory = [];
    private string transitionKey = Guid.NewGuid().ToString();
    private string transitionClass = "animate-fade-in-up";

    protected override void OnInitialized()
    {
        AuthState.AuthenticationExpired += OnAuthenticationExpired;
        navHistory.Add(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Heuristic (no native navigation-stack API in a Blazor SPA): treat landing back on the entry
        // just before the current one as "back" (slide from the left); anything else is a "forward" push
        // (slide from the right) — matches the M-9.2 example (Exercises list -> Detail = forward) without
        // needing every call site to explicitly declare its own direction.
        if (navHistory.Count >= 2 && navHistory[^2] == e.Location)
        {
            navHistory.RemoveAt(navHistory.Count - 1);
            transitionClass = "animate-slide-in-left";
        }
        else
        {
            navHistory.Add(e.Location);
            transitionClass = "animate-slide-in-right";
        }

        transitionKey = Guid.NewGuid().ToString();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        // AuthState.IsAuthenticated is only ever true here if Login already signed the user in during
        // THIS app process (password or biometric) — a cold launch always starts with it false, which
        // is what lets the biometric gate below re-run on every fresh launch without looping back on
        // itself after Login navigates to "/".
        if (!AuthState.IsAuthenticated)
        {
            if (await BiometricLoginService.IsEnabledAsync())
            {
                // Biometric login is opted in: never silently reuse the stored token on a cold launch —
                // send the user through Login so they must unlock it with a fingerprint/Face ID check first.
                Navigation.NavigateTo("/login");
                return;
            }

            // AuthState is a fresh in-memory singleton on every app launch — re-derive it from whatever
            // token SecureStorage still has before this authenticated shell is allowed to render @Body,
            // so no protected page ever mounts without a stored token (persistent login / M-1.3).
            var accessToken = await TokenStore.GetAccessTokenAsync();
            if (string.IsNullOrEmpty(accessToken))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            AuthState.SignIn();
        }

        isAuthorized = true;

        // Refresh cached plans/exercises/last session now that the shell is authorized. If the
        // access token has expired, AuthDelegatingHandler transparently refreshes it here; if that
        // refresh also fails it raises AuthenticationExpired, which OnAuthenticationExpired below
        // catches to clear tokens and send the user back to Login.
        await SyncService.RefreshAsync();
        await LanguageSync.SyncAsync();
    }

    private void OnAuthenticationExpired()
    {
        isAuthorized = false;
        InvokeAsync(() =>
        {
            Navigation.NavigateTo("/login");
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        AuthState.AuthenticationExpired -= OnAuthenticationExpired;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
