@* Reusable masked/plain-text toggle for password fields — reset to masked on every fresh render since
   `showPassword` is plain component state that doesn't survive navigating away and back. *@
@using System.Linq.Expressions

<div class="relative">
    <InputText id="@Id" type="@(showPassword ? "text" : "password")" class="input pr-10" @bind-Value="CurrentValue" />
    <button type="button"
            class="absolute inset-y-0 right-2 flex items-center text-text-secondary"
            aria-label="@(showPassword ? "Hide password" : "Show password")"
            @onclick="() => showPassword = !showPassword">
        @if (showPassword)
        {
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M10.58 10.58a2 2 0 002.83 2.83M9.88 4.24A9.77 9.77 0 0112 4c5 0 9.27 3.11 11 7-.64 1.44-1.56 2.73-2.68 3.79M6.61 6.61C4.6 8 3.02 9.9 2 11c1.73 3.89 6 7 10 7 1.35 0 2.65-.27 3.83-.76" />
            </svg>
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15a3 3 0 100-6 3 3 0 000 6z" />
            </svg>
        }
    </button>
</div>

@code {
    [Parameter] public string Id { get; set; } = "password";
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }

    private bool showPassword;

    private string CurrentValue
    {
        get => Value;
        set => _ = ValueChanged.InvokeAsync(value);
    }
}
