@* Animated pill switch (M-9.1) — the thumb slides via a CSS transition instead of a native checkbox
   snapping between states. *@
<label class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full transition-colors duration-transition ease-app @(Value ? "bg-primary" : "bg-border")">
    <input type="checkbox" class="sr-only" checked="@Value" disabled="@Disabled" @onchange="OnChangeAsync" />
    <span class="inline-block h-5 w-5 transform rounded-full bg-white shadow transition-transform duration-transition ease-app @(Value ? "translate-x-5" : "translate-x-0.5")"></span>
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnChangeAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is bool value && value);
}
